# ==============================================================================
# CampusTrade environment template (.env.example)
# Copy this file to .env and fill in every value marked "CHANGE_ME":
#   cp .env.example .env
# Compose refuses to start when a required credential is missing, so a plain
# copy works out of the box for local development, but you SHOULD replace the
# CHANGE_ME placeholders before exposing anything beyond your own machine.
# NEVER commit a .env that contains real secrets - it is git-ignored.
#
# NOTE: keep this file ASCII-only. cmd.exe (backend/run-backend.cmd) parses .env
# line by line with `for /f`; UTF-8 Chinese bytes directly before a newline are
# decoded as one double-byte character in a GBK console and EAT that newline,
# which silently drops the next KEY=VALUE line. Chinese documentation for these
# variables lives in README.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Backend HTTP port - THE single source of truth for the backend port
# ------------------------------------------------------------------------------
# Every consumer reads this one value; there is no second place to change:
#   backend/run-backend.cmd  -> exports it as SERVER_PORT for Spring Boot
#   application.yml          -> server.port: ${SERVER_PORT:8081}
#   start.ps1 / stop.ps1     -> port pre-check, wait loop, printed URLs
#   frontend/config default  -> see API_BASE_URL at the bottom (keep in sync)
# 8081 is the default because 8080 is often taken by another local project.
BACKEND_PORT=8081

# ------------------------------------------------------------------------------
# 1. PostgreSQL (docker-compose.yml service "postgres")
# ------------------------------------------------------------------------------
# Host port mapping. 15435 is this project's documented development port; change
# it if that port is already taken on your machine (keep SPRING_DATASOURCE_PORT
# in sync with it - they must be the same port).
POSTGRES_PORT=15435
POSTGRES_DB=campustrade
POSTGRES_USER=campustrade
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Backend Spring Boot datasource (must point at the mapped host port above)
SPRING_DATASOURCE_HOST=127.0.0.1
SPRING_DATASOURCE_PORT=15435
SPRING_DATASOURCE_DATABASE=campustrade
SPRING_DATASOURCE_USERNAME=campustrade
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
SPRING_DATASOURCE_SCHEMA=campus_trade

# ------------------------------------------------------------------------------
# 2. Redis (docker-compose.yml service "redis")
# ------------------------------------------------------------------------------
# Redis now requires authentication in every environment (including development).
# REDIS_PASSWORD is injected into the container via `--requirepass`; the backend
# reads the SAME value through SPRING_DATA_REDIS_PASSWORD - keep them identical.
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 3. MinIO object storage (docker-compose.yml service "minio")
# ------------------------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET_NAME=campustrade
# Public URL prefix returned to clients for uploaded images (must be reachable
# from the browser, i.e. the mapped MINIO_PORT, not the container port).
MINIO_URL_PREFIX=http://127.0.0.1:9000/campustrade

# ------------------------------------------------------------------------------
# 4. JWT signing key - REQUIRED, there is NO default in the application
#    Generate one and paste it below (never reuse a sample value):
#      openssl rand -hex 32
#    The backend refuses to start when JWT_SECRET is missing, shorter than 32
#    bytes, or still equal to the historical default key.
# ------------------------------------------------------------------------------
JWT_SECRET=

# ------------------------------------------------------------------------------
# 5. CORS allowed origins (comma separated, port wildcard supported)
#    Keep the local defaults for development; production must list real domains.
#    Never use "*" here: allowCredentials is enabled.
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ------------------------------------------------------------------------------
# 6. DeepSeek AI (reserved: AI pricing / description polishing)
#    Optional. Leave the placeholder to keep the feature disabled/unconfigured.
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 7. Campus verification email (SMTP)
#    verify.mail-enabled is the single switch for where the verify code goes:
#      false (default, local dev) -> the code is written to the backend log file
#                                    (backend/logs/campustrade.log, [DEV-ONLY] line)
#      true                       -> the code is sent to the student campus mailbox
#    Production (profile: prod) REQUIRES mail-enabled=true plus every MAIL_* value
#    below; otherwise the backend refuses to start and prints a Chinese hint
#    (com.campustrade.config.VerifyMailProdGuard, same style as the JWT fail-fast).
#    Keep these empty locally and NEVER commit real mailbox credentials/authorization
#    codes: the backend reads them from the process environment only.
# ------------------------------------------------------------------------------
VERIFY_MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SSL_ENABLED=true

# ------------------------------------------------------------------------------
# 8. Frontend (Flutter) runtime
#    API_BASE_URL is NOT read from .env at build time: the value below is only the
#    documented default that lib/config/app_config.dart already bakes in. To point
#    a build at another backend, pass it as a compile-time define, e.g.
#      flutter run   -d chrome --dart-define=API_BASE_URL=http://10.0.0.5:8081/api
#      flutter build web        --dart-define=API_BASE_URL=https://api.example.com/api
#    See frontend/README.md for the full Web deployment notes.
# ------------------------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8081/api
