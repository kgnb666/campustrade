# ==============================================================================
# CampusTrade 环境变量配置模板 (.env.example)
# 请复制本文件并重命名为 .env，根据本地实际情况修改配置
# 注意：禁止将包含真实密钥的 .env 文件提交到代码仓库！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 数据库配置
# ------------------------------------------------------------------------------
# 宿主机映射端口（如 5432 被本地已安装服务占用，可改为 15432 或其他空闲端口）
POSTGRES_PORT=5432
POSTGRES_DB=campustrade
POSTGRES_USER=campustrade
POSTGRES_PASSWORD=campustrade123

# 后端 Spring Boot 数据库连接配置
SPRING_DATASOURCE_HOST=127.0.0.1
SPRING_DATASOURCE_PORT=5432
SPRING_DATASOURCE_DATABASE=campustrade
SPRING_DATASOURCE_USERNAME=campustrade
SPRING_DATASOURCE_PASSWORD=campustrade123
SPRING_DATASOURCE_SCHEMA=campus_trade

# ------------------------------------------------------------------------------
# 2. Redis 缓存配置
# ------------------------------------------------------------------------------
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. MinIO 对象存储配置 (用于未来商品图片与附件存储)
# ------------------------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=campustrade
MINIO_ROOT_PASSWORD=campustrade123
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET_NAME=campustrade

# ------------------------------------------------------------------------------
# 4. JWT 认证密钥配置
# ------------------------------------------------------------------------------
JWT_SECRET=campustrade-super-secure-jwt-secret-key-2026-campus-trade-platform-xyz-token

# ------------------------------------------------------------------------------
# 5. DeepSeek AI 开放接口预留配置 (用于未来 AI 辅助估价、商品描述润色等)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 5. 前端 Flutter 运行环境变量配置
# ------------------------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8080/api
