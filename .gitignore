# Environment variables
.env
.env.local
# Machine-local toolchain paths (JAVA_HOME / MAVEN_HOME / FLUTTER_ROOT), read by
# scripts/toolchain.ps1, backend/resolve-toolchain.cmd and frontend/run-frontend.cmd.
# It holds absolute paths of THIS machine only, so it is never committed.
.env.tools

# IDE & Editors
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS files
.DS_Store
Thumbs.db

# Backend build artifacts
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar

# Frontend build artifacts
frontend/.dart_tool/
frontend/build/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages

# Native build caches
frontend/android/.gradle/
frontend/android/local.properties
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/macos/Pods/
frontend/linux/flutter/ephemeral/
frontend/windows/flutter/ephemeral/

# Logs
*.log
logs/
backend/logs/

# Local tool state & scratch notes (kept on disk, out of the repo)
.mimosa/
.workbuddy/
.local-notes/
