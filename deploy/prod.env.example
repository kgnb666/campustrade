# ==============================================================================
#  CampusTrade 生产变量模板（服务器端，建议放 /etc/campustrade/prod.env）
#
#  为什么单独一份：compose 默认会读取仓库根目录的 .env（那是本地开发口令）。
#  在服务器上必须用 --env-file /etc/campustrade/prod.env 显式指向本文件，
#  ProdSecretsGuard 也会在启动期拒绝"开发口令 / CHANGE_ME 占位值"。
#
#  权限建议：chmod 600，属主 root:root（只有部署账号能读）。
#  仓库里只保留这份模板，永远不要提交含真实口令的 prod.env。
#
#  变量替换规则：本文件里 ${...} 不会被 compose 展开（compose 只展开 YAML 中的
#  引用），所以下面的 PUBLIC_BASE_URL 只是给人看的占位符写法 —— 落地时请把
#  CORS_ALLOWED_ORIGINS 与 MINIO_URL_PREFIX 都写成真实的绝对地址。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 外部访问地址（决定 CORS 白名单与图片前缀，必须与实际访问地址一致）
# ------------------------------------------------------------------------------
# 边缘 Nginx 发布的宿主端口；只允许本机访问时把 EDGE_BIND 改成 127.0.0.1
EDGE_PORT=8080
EDGE_BIND=0.0.0.0
# 前端 Web 产物在宿主机上的目录（flutter build web 的输出）
WEB_ROOT=/opt/campustrade/web

# ------------------------------------------------------------------------------
# 2. 后端与中间件凭据（生成方式：openssl rand -hex 24 / openssl rand -hex 32）
# ------------------------------------------------------------------------------
POSTGRES_DB=campustrade
POSTGRES_USER=campustrade
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=campustrade
# 图片对外前缀：走边缘 Nginx 的 /img/ 反代，浏览器无需直连 MinIO
MINIO_URL_PREFIX=http://CHANGE_ME_PUBLIC_HOST:8080/img/campustrade

JWT_SECRET=CHANGE_ME_JWT_SECRET

# 生产绝不允许 "*"（allowCredentials 恒为 true）；与前端实际来源保持一致
CORS_ALLOWED_ORIGINS=http://CHANGE_ME_PUBLIC_HOST:8080

# ------------------------------------------------------------------------------
# 3. 校园认证邮件（prod 必填：mail-enabled 固定 true，缺项直接拒绝启动）
#    腾讯企业邮箱示例：smtp.exmail.qq.com:465（SSL）
#    QQ 邮箱示例：smtp.qq.com:465（MAIL_PASSWORD 填"授权码"，不是登录密码）
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME_MAIL_USERNAME
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_FROM=CHANGE_ME_MAIL_USERNAME
MAIL_SSL_ENABLED=true

# ------------------------------------------------------------------------------
# 4. 反向代理与限流维度
#    前面有 Nginx 时必须配置，否则所有用户共用"代理的 IP"这一个限流维度，
#    IP 维度的登录失败锁定会误伤全站。生产入口是边缘容器，后端看到的对端是
#    容器网络地址，因此填 compose 网桥网段（172.16.0.0/12 覆盖 Docker 默认桥）。
#    绝不能写 0.0.0.0/0（等于无条件采信客户端头部）。
# ------------------------------------------------------------------------------
SECURITY_TRUSTED_PROXIES=172.16.0.0/12

# ------------------------------------------------------------------------------
# 5. 可选：镜像 tag 与资源调优
# ------------------------------------------------------------------------------
# 应用镜像 tag 必须与后端 pom.xml 版本号（去掉 -SNAPSHOT）一致
APP_IMAGE_TAG=0.0.1
# 小内存机器（2-4G）建议收敛 JVM 堆，避免与中间件抢内存
# JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
# SPRING_DATASOURCE_MAX_POOL_SIZE=10
# AI_QUOTA_DAILY_LIMIT=50
# AI_QUOTA_PER_MINUTE_LIMIT=10
